# copy to .env, fill in real values, then run: source .env
# .env is git-ignored. Never commit it. 

# AWS authentication: use the profile from 'aws configure'
export AWS_PROFILE="default"
export AWS_REGION="ap-south-1"

# Remote state backend names it don't have TF_VAR, below variables can be used at terraform init command, but not as terraform variables.
export TF_STATE_BUCKET="yourname-terraform-state-2026"  # this is only used in your terraform init command, not as terraform variable.
export TF_LOCK_TABLE="terraform-state-lock" # this is only used in your terraform init command, not as terraform variable.

# Terraform input variables (TF_VAR_<name> -> var.<name>)
export TF_VAR_aws_region="$AWS_REGION"
export TF_VAR_state_bucket_name="$TF_STATE_BUCKET"
export TF_VAR_lock_table_name="$TF_LOCK_TABLE"
export TF_VAR_key_name="my-ec2-key"
export TF_VAR_ssh_allowed_cidr="0.0.0.0/32" #it is recommended to use your own IP address instead of 0.0.0.0/32.
export TF_VAR_instance_type="t3.micro"
export TF_VAR_environment="dev"